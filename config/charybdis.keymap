#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "hold-preferred";
    quick-tap-ms = <170>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&none  &none       &none       &none         &none         &none        &none        &none            &none        &none       &none          &none
&none  &kp Q       &kp W       &kp E         &kp R         &kp T        &kp Y        &kp U            &kp I        &kp O       &kp P          &none
&none  &mt LGUI A  &mt LALT S  &mt LCTRL D   &mt LSHIFT F  &kp G        &kp H        &mt RSHIFT J     &mt RCTRL K  &mt RALT L  &mt RGUI APOS  &none
&none  &lt 4 Z     &kp X       &kp C         &kp V         &kp B        &kp N        &kp M            &kp COMMA    &kp DOT     &lt 4 SLASH    &none
                               &lt 3 ESCAPE  &lt 2 SPACE   &lt 1 TAB    &lt 6 ENTER  &lt 5 BACKSPACE
                                             &none         &none        &none
            >;
        };

        Function {
            display-name = "Function";
            bindings = <
&none     &none     &none     &none      &none      &none             &none            &none   &none   &none   &none    &none
&none     &none     &none     &none      &none      &none             &kp PSCRN        &kp F7  &kp F8  &kp F9  &kp F12  &none
&kp LGUI  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none             &kp SCROLLLOCK   &kp F4  &kp F5  &kp F6  &kp F11  &none
&none     &none     &none     &none      &none      &none             &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10  &none
                              &none      &none      &trans            &none            &none
                                         &none      &studio_unlock    &none
            >;
        };

        Navigation {
            display-name = "Navigation";
            bindings = <
&none     &none     &none     &none      &none      &none    &none         &none          &none     &none     &none      &none
&none     &none     &none     &none      &none      &none    &none         &none          &none     &none     &none      &none
&kp LGUI  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp CAPSLOCK  &kp LEFT       &kp DOWN  &kp UP    &kp RIGHT  &none
&none     &none     &none     &none      &none      &none    &kp INSERT    &kp HOME       &kp PGDN  &kp PGUP  &kp END    &none
                              &none      &trans     &none    &kp ENTER     &kp BACKSPACE
                                         &none      &none    &none
            >;
        };

        Media {
            display-name = "Media";
            bindings = <
&none  &none       &none              &none       &none             &none          &none        &none             &none       &none         &none       &none
&none  &none       &none              &none       &none             &none          &none        &none             &none       &none         &none       &none
&none  &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP   &kp C_NEXT     &kp C_PREV   &kp C_VOL_DN      &kp C_MUTE  &kp C_VOL_UP  &kp C_NEXT  &none
&none  &none       &none              &none       &none             &bootloader    &bootloader  &none             &none       &none         &none       &none
                                      &trans      &kp C_PLAY_PAUSE  &kp C_STOP     &kp C_STOP   &kp C_PLAY_PAUSE
                                                  &none             &none          &none
            >;
        };

        Pointer {
            display-name = "Pointer";
            bindings = <
&none     &none     &none     &none      &none      &none          &none        &none       &none      &none     &none     &none
&none     &none     &none     &none      &none      &none          &none        &none       &none      &none     &none     &none
&kp LGUI  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none          &none        &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&trans    &none     &mo 8     &mo 7      &none      &bootloader    &bootloader  &none       &mo 7      &mo 8     &none     &trans
                              &mkp MB2   &mkp MB1   &mkp MB3       &mkp MB3     &mkp MB1
                                         &tog 8     &tog 7         &none
            >;
        };

        Numeral {
            display-name = "Numeral";
            bindings = <
&none      &none             &none            &none            &none            &none        &none           &none       &none      &none     &none     &none
&kp LBKT   &kp LEFT_BRACKET  &kp KP_NUMBER_8  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp RBKT     &none           &none       &none      &none     &none     &none
&kp SEMI   &kp SEMICOLON     &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_6  &kp EQUAL    &none           &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&kp GRAVE  &kp GRAVE         &kp KP_NUMBER_1  &kp KP_NUMBER_3  &kp KP_NUMBER_3  &kp BSLH     &none           &none       &none      &none     &none     &none
                                              &kp DOT          &kp N0           &kp MINUS    &studio_unlock  &trans
                                                               &none            &none        &none
            >;
        };

        Symbols {
            display-name = "Symbols";
            bindings = <
&none      &none           &none       &none                 &none                  &none              &none   &none       &none      &none     &none     &none
&kp LBRC   &kp LEFT_BRACE  &kp AMPS    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &none   &none       &none      &none     &none     &none
&kp COLON  &kp COLON       &kp DOLLAR  &kp PRCNT             &kp RCTRL              &kp PLUS           &none   &kp RSHIFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&kp TILDE  &kp TILDE       &kp EXCL    &kp AT                &kp HASH               &kp PIPE           &none   &none       &none      &none     &none     &none
                                       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans  &none
                                                             &none                  &none              &none
            >;
        };

        Scroll {
            display-name = "Scroll";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans      &trans    &trans     &trans     &trans    &trans    &trans
&trans  &trans    &trans    &trans     &trans     &trans      &trans    &trans     &trans     &trans    &trans    &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans      &trans    &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &trans    &trans    &trans     &trans     &trans      &trans    &trans     &trans     &trans    &trans    &trans
                            &mkp MB2   &mkp MB1   &mkp MB3    &mkp MB3  &mkp MB1
                                       &none      &trans      &trans
            >;
        };

        Snipe {
            display-name = "Snipe";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans      &trans    &trans     &trans     &trans    &trans    &trans
&trans  &trans    &trans    &trans     &trans     &trans      &trans    &trans     &trans     &trans    &trans    &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans      &trans    &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &trans    &trans    &trans     &trans     &trans      &trans    &trans     &trans     &trans    &trans    &trans
                            &mkp MB2   &mkp MB1   &mkp MB3    &mkp MB3  &mkp MB1
                                       &trans     &trans      &none
            >;
        };
    };
};
