#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I   &kp O   &kp P   &kp BACKSPACE
&kp LSHIFT  &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHIFT F  &kp G  &kp H  &mt RSHIFT J  &mt RCTRL K  &mt LALT L  &kp SEMI  &mt RGUI APOS
&kp LCTRL  &lt 4 Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &lt 4 SLASH  &kp ESCAPE
                                 &lt 3 ESC  &lt 2 SPACE  &lt 1 TAB  &lt 6 ENTER  &lt 5 BACKSPACE
                                               &kp LALT  &kp CAPSLOCK  &kp DELETE
            >;
        };

        Function {
            display-name = "Function";
            bindings = <
&kp F1     &kp F2     &kp F3    &kp F4    &kp F5    &kp F6            &kp F7          &kp F8    &kp F9    &kp F10  &kp F11   &kp F12
&kp ESCAPE  &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4            &kp N5          &kp N6    &kp N7    &kp N8   &kp N9    &kp N0
&kp MINUS   &kp EQUAL  &kp LBKT  &kp RBKT  &kp BACKSPACE  &kp BACKSLASH  &kp SEMI  &kp APOS  &kp COMMA  &kp DOT  &kp SLASH  &kp TAB
&trans     &trans     &trans    &trans    &trans    &trans            &trans          &trans    &trans    &trans   &trans    &trans
                                &none     &none     &studio_unlock    &studio_unlock  &none
                                          &trans    &trans            &trans
            >;
        };

        Navigation {
            display-name = "Navigation";
            bindings = <
&none   &none         &none     &none          &none        &none        &none     &none     &none     &none    &none   &none
&none   &kp CAPSLOCK  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT    &kp HOME  &kp PGDN  &kp PGUP  &kp END  &none   &none
&none   &kp INSERT    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END      &none     &none     &none     &none    &none   &none
&trans  &trans        &trans    &trans         &trans       &trans       &trans    &trans    &trans    &trans   &trans  &trans
                                &none          &none        &none        &none     &none
                                               &trans       &trans       &trans
            >;
        };

        Media {
            display-name = "Media";
            bindings = <
&kp MPRV     &kp VOLD       &kp MUTE  &kp VOLU  &kp MNXT    &none         &none      &none            &none             &none         &none        &none
&kp PAGE_UP  &kp PAGE_DOWN  &kp HOME  &kp END   &kp INSERT  &kp DELETE    &kp PAUSE  &kp SCROLL_LOCK  &kp PRINT_SCREEN  &kp CAPSLOCK  &kp NUMLOCK  &none
&none        &none          &none     &none     &none       &none         &none      &none            &none             &none         &none        &none
&trans       &trans         &trans    &trans    &trans      &trans        &trans     &trans           &trans            &trans        &trans       &trans
                                      &none     &none       &none         &none      &none
                                                &trans      &trans        &trans
            >;
        };

        Pointer {
            display-name = "Pointer";
            bindings = <
&none   &none   &none   &none     &none     &none       &none     &none     &none   &none   &none   &none
&none   &none   &none   &none     &none     &none       &none     &none     &none   &none   &none   &none
&none   &none   &none   &none     &none     &none       &none     &none     &none   &none   &none   &none
&trans  &trans  &trans  &trans    &trans    &trans      &trans    &trans    &trans  &trans  &trans  &trans
                        &mkp MB2  &mkp MB1  &mkp MB3    &mkp MB3  &mkp MB1
                                  &trans    &trans      &trans
            >;
        };

        Numeral {
            display-name = "Numeral";
            bindings = <
&kp LBKT   &kp N7  &kp N8     &kp N9  &kp RBKT       &none     &none   &none  &none  &none  &none  &none
    &kp SEMI   &kp N4  &kp N5     &kp N6  &kp EQUAL      &none     &none   &none  &none  &none  &none  &none
&kp GRAVE  &kp N1  &kp N2     &kp N3  &kp BACKSLASH  &none     &none   &none  &none  &none  &none  &none
&kp DOT    &kp N0  &kp MINUS  &none   &none          &none     &none   &none  &none  &none  &none  &none
                              &none   &none          &none     &none   &none
                                      &trans         &trans    &trans
            >;
        };

        Symbols {
            display-name = "Symbols";
            bindings = <
&kp LBKT   &kp N7  &kp N8     &kp N9  &kp RBKT       &none     &none   &none  &none  &none  &none  &none
    &kp SEMI   &kp N4  &kp N5     &kp N6  &kp EQUAL      &none     &none   &none  &none  &none  &none  &none
&kp GRAVE  &kp N1  &kp N2     &kp N3  &kp BACKSLASH  &none     &none   &none  &none  &none  &none  &none
&kp DOT    &kp N0  &kp MINUS  &none   &none          &none     &none   &none  &none  &none  &none  &none
                              &none   &none          &none     &none   &none
                                      &trans         &trans    &trans
            >;
        };
    };
};
